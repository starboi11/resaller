NODE_ENV=development
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000
API_HOST=0.0.0.0
TRUST_PROXY=false
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional visual-only catalogue when the local API is unavailable; never enable for real acceptance tests.
DEMO_CATALOG_ENABLED=false
DATABASE_URL=postgresql://resaller:resaller_dev_only@localhost:5432/resaller?schema=public
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-separate-at-least-32-random-characters
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MEDIA_ROOT=./data/media
PRIVATE_MEDIA_ROOT=./data/private-media
MEDIA_STORAGE_DRIVER=local
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
TELEGRAM_SUPPORT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SUPPORT_CHAT_ID=
TELEGRAM_SUPPORT_OPERATOR_NAME=Resaller Support
TELEGRAM_WEBHOOK_URL=https://api.resaller.uz/api/v1/support/telegram/webhook
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
METRICS_TOKEN=
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=resaller-media
S3_PRIVATE_BUCKET=resaller-private-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
RUN_DB_TESTS=0
CLAMAV_HOST=
CLAMAV_PORT=3310

# Username of the owner store; buyers see only its listings. Empty = no filter (local only).
OWNER_STORE_USERNAME=

# Admin TOTP. "false" = admin signs in with the 16+ char password from admin:account only.
ADMIN_TWO_FACTOR_REQUIRED=true
