FROM node:24-alpine AS build
WORKDIR /app
RUN corepack enable
COPY . .
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm install --frozen-lockfile && pnpm --filter @resaller/admin build
ENV NODE_ENV=production
EXPOSE 3001
CMD ["pnpm", "--filter", "@resaller/admin", "start"]
