# Go API image. Not yet referenced by compose files: the Node API stays in
# production until every route passes parity (docs/GO-MIGRATION-HANDOFF.md).
FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY apps/api-go/go.mod apps/api-go/go.sum ./
COPY apps/api-go/third_party ./third_party
RUN go mod download
COPY apps/api-go/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/api /api
ENV NODE_ENV=production API_PORT=4000
EXPOSE 4000
USER nonroot:nonroot
ENTRYPOINT ["/api"]
