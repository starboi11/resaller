DOMAIN=staging.resaller.uz
STAGING_DOMAIN=staging.resaller.uz
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-different-at-least-32-random-key
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=resaller-staging-media
S3_PRIVATE_BUCKET=resaller-staging-private
S3_ACCESS_KEY_ID=store-only-in-server-secret-manager
S3_SECRET_ACCESS_KEY=store-only-in-server-secret-manager
S3_FORCE_PATH_STYLE=false
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
METRICS_TOKEN=replace-with-a-long-random-metrics-token
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-backup-key
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=resaller-staging-backups
BACKUP_S3_ACCESS_KEY_ID=store-only-in-server-secret-manager
BACKUP_S3_SECRET_ACCESS_KEY=store-only-in-server-secret-manager
BACKUP_S3_REGION=auto

OWNER_STORE_USERNAME=replace-with-owner-store-username

ADMIN_TWO_FACTOR_REQUIRED=true
ADMIN_BASE_PATH=replace-with-generated-path
