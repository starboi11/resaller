DOMAIN=resaller.uz
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
MEDIA_STORAGE_DRIVER=s3
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=resaller-media
S3_PRIVATE_BUCKET=resaller-private-media
S3_ACCESS_KEY_ID=store-only-in-server-secret-manager
S3_SECRET_ACCESS_KEY=store-only-in-server-secret-manager
S3_FORCE_PATH_STYLE=false
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
TELEGRAM_BOT_TOKEN=
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
METRICS_TOKEN=replace-with-a-long-random-metrics-token
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-backup-key
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=resaller-encrypted-backups
BACKUP_S3_ACCESS_KEY_ID=store-only-in-server-secret-manager
BACKUP_S3_SECRET_ACCESS_KEY=store-only-in-server-secret-manager
BACKUP_S3_REGION=auto
